# Copy this file to .env.production. Never commit the real file.
# Public deployment values
APP_ORIGIN=https://wiki.example.com
CORS_ALLOWED_ORIGINS=https://wiki.example.com
MCP_PUBLIC_URL=https://wiki.example.com/mcp
MCP_ALLOWED_HOSTS=wiki.example.com
MCP_ALLOWED_ORIGINS=https://wiki.example.com
HTTP_BIND_ADDRESS=0.0.0.0
HTTP_PORT=80
HTTPS_BIND_ADDRESS=0.0.0.0
HTTPS_PORT=443
API_NODE_ENV=production
# Lokale Builds verwenden "local". Releases aus GHCR verwenden beispielsweise
# AD_WIKI_IMAGE_TAG=v1.0.0. Forks können zusätzlich den Registry-Präfix ändern.
AD_WIKI_IMAGE_PREFIX=ghcr.io/alid-it/ad-wiki
AD_WIKI_IMAGE_TAG=local

# TLS termination in the nginx container.
# Use forward slashes for absolute Windows paths, e.g. C:/certs/wiki.example.com.crt
# Leave CERT and KEY empty to create and persist a self-signed fallback certificate.
# CA chain is optional for a supplied certificate but recommended for public CAs.
TLS_DOMAIN=wiki.example.com
TLS_CERT_PATH=
TLS_KEY_PATH=
TLS_CA_CHAIN_PATH=
TLS_SELF_SIGNED_DAYS=825

# Database names (not secrets)
POSTGRES_USER=adwiki
POSTGRES_DB=adwiki_wiki

# Local backup mount used by the isolated operations containers.
# Create this directory before starting the stack. Linux hosts must grant the
# configured numeric user write access. Use forward slashes on every platform.
BACKUP_LOCAL_PATH=./backups
# Optional: ein auf dem Host vorab eingehängtes Netzwerk-Dateisystem.
# AD-Wiki mountet keine Freigaben selbst. Ohne Angabe wird der lokale Pfad verwendet.
BACKUP_NETWORK_PATH=./backups
BACKUP_UID=1000
BACKUP_GID=1000
BACKUP_POLL_INTERVAL_MS=2000
# Nach diesem RPO-Fenster ohne erfolgreichen Stand wird alarmiert.
BACKUP_STALE_AFTER_HOURS=26
# Worker gilt nach diesem Zeitraum ohne Redis-Heartbeat als ausgefallen.
BACKUP_WORKER_STALE_AFTER_SECONDS=60
# Toleranz für fällige Sicherungspläne, bevor sie als überfällig gelten.
BACKUP_SCHEDULE_GRACE_MINUTES=5
# Grenzwerte für den freien Speicher des Upload-Volumes.
UPLOAD_DISK_WARNING_FREE_PERCENT=15
UPLOAD_DISK_CRITICAL_FREE_PERCENT=8

# Initial installation. The password is used only if this account does not exist.
INITIAL_ADMIN_EMAIL=admin@example.com
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_DISPLAY_NAME=Administrator
SITE_NAME=AD-Wiki
ALLOW_REGISTRATION=false

# Authentication and throttling
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
# Gültigkeit einmaliger Passwort-Reset-Links (5 bis 1440 Minuten)
PASSWORD_RESET_TTL_MINUTES=30
THROTTLE_TTL=60000
THROTTLE_LIMIT=100
# Nur bei einem kontrollierten internen Keycloak: exakte DNS-Namen,
# kommasepariert. IP-Adressen und localhost werden weiterhin abgewiesen.
OIDC_ALLOWED_PRIVATE_HOSTS=
MCP_RATE_LIMIT_READ=120
MCP_RATE_LIMIT_WRITE=30
MCP_RATE_LIMIT_WINDOW_MS=60000

# Optional Microsoft Entra / Microsoft To Do integration.
# Leave IDs and redirect URI empty when disabled. The secret variable below must
# still contain a random placeholder because Docker Compose mounts it as a secret.
MICROSOFT_TENANT_ID=
MICROSOFT_CLIENT_ID=
MICROSOFT_REDIRECT_URI=https://wiki.example.com/api/v1/integrations/microsoft/callback

# Secrets: generate unique random values; examples are intentionally blank.
# General 48-byte secret (PowerShell): $b=[byte[]]::new(48); $r=[Security.Cryptography.RandomNumberGenerator]::Create(); $r.GetBytes($b); $r.Dispose(); [Convert]::ToBase64String($b)
# Integration/SMTP and SSO keys, each exactly 32 bytes (PowerShell): $b=[byte[]]::new(32); $r=[Security.Cryptography.RandomNumberGenerator]::Create(); $r.GetBytes($b); $r.Dispose(); [Convert]::ToBase64String($b)
AD_WIKI_POSTGRES_PASSWORD=
AD_WIKI_JWT_SECRET=
AD_WIKI_MONITORING_TOKEN=
AD_WIKI_INTEGRATION_ENCRYPTION_KEY=
AD_WIKI_SSO_ENCRYPTION_KEY=
AD_WIKI_BACKUP_ENCRYPTION_KEY=
AD_WIKI_MICROSOFT_CLIENT_SECRET=
AD_WIKI_INITIAL_ADMIN_PASSWORD=
