{
  "name": "ad-wiki",
  "version": "0.1.0",
  "private": true,
  "description": "AD-Wiki - Open Source Knowledge Base",
  "license": "MIT",
  "packageManager": "npm@11.6.2",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "test:mcp": "npm run test:mcp --workspace=api",
    "db:migrate": "npm run db:migrate --workspace=api",
    "db:studio": "npm run db:studio --workspace=api",
    "docker:config": "docker compose --env-file .env.production -f docker-compose.prod.yml config",
    "docker:build": "docker compose --env-file .env.production -f docker-compose.prod.yml build",
    "docker:up": "docker compose --env-file .env.production -f docker-compose.prod.yml up -d",
    "docker:rebuild": "docker compose --env-file .env.production -f docker-compose.prod.yml down --remove-orphans && docker compose --env-file .env.production -f docker-compose.prod.yml build && docker compose --env-file .env.production -f docker-compose.prod.yml up -d",
    "docker:down": "docker compose --env-file .env.production -f docker-compose.prod.yml down",
    "docker:logs": "docker compose --env-file .env.production -f docker-compose.prod.yml logs -f"
  },
  "devDependencies": {
    "concurrently": "^10.0.3",
    "find-my-way": "9.7.0",
    "turbo": "^2.5.0",
    "valibot": "1.4.2"
  },
  "overrides": {
    "@swc/helpers": "0.5.23",
    "@modelcontextprotocol/node": {
      "@hono/node-server": "2.0.11"
    },
    "@prisma/dev": {
      "find-my-way": "9.7.0",
      "valibot": "1.4.2"
    },
    "fast-uri": "3.1.4",
    "postcss": "8.5.23",
    "sharp": "0.35.3"
  },
  "allowScripts": {
    "sharp@0.35.3": true,
    "prisma@7.9.0": true,
    "@prisma/engines@7.9.0": true,
    "bcrypt@6.0.0": true,
    "@swc/core@1.15.43": true,
    "unrs-resolver@1.12.2": true,
    "@parcel/watcher@2.5.6": true
  }
}
