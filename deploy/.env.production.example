# Diese Datei als .env kopieren. Die echte .env niemals committen.

# Oeffentliche Adresse
APP_ORIGIN=https://wiki.example.com
CORS_ALLOWED_ORIGINS=https://wiki.example.com
MCP_PUBLIC_URL=https://wiki.example.com/mcp
MCP_ALLOWED_HOSTS=wiki.example.com
MCP_ALLOWED_ORIGINS=https://wiki.example.com
HTTP_BIND_ADDRESS=0.0.0.0
HTTP_PORT=80
HTTPS_BIND_ADDRESS=0.0.0.0
HTTPS_PORT=443
API_NODE_ENV=production

# Der Release-Workflow ersetzt beide Platzhalter durch die Release-Version.
AD_WIKI_IMAGE_PREFIX=ghcr.io/alid-it/ad-wiki
AD_WIKI_IMAGE_TAG=__AD_WIKI_IMAGE_TAG__
AD_WIKI_VERSION=__AD_WIKI_VERSION__

# TLS: Zertifikat und Schluessel leer lassen, um ein selbstsigniertes
# Zertifikat zu erstellen. Fuer eigene Zertifikate absolute Linux-Pfade setzen.
TLS_DOMAIN=wiki.example.com
TLS_CERT_PATH=
TLS_KEY_PATH=
TLS_CA_CHAIN_PATH=
TLS_SELF_SIGNED_DAYS=825

# Datenbank
POSTGRES_USER=adwiki
POSTGRES_DB=adwiki_wiki

# Backup-Verzeichnisse auf dem Docker-Host
BACKUP_LOCAL_PATH=./backups
BACKUP_NETWORK_PATH=./backups
BACKUP_UID=1000
BACKUP_GID=1000
BACKUP_POLL_INTERVAL_MS=2000
BACKUP_STALE_AFTER_HOURS=26
BACKUP_WORKER_STALE_AFTER_SECONDS=60
BACKUP_SCHEDULE_GRACE_MINUTES=5
UPLOAD_DISK_WARNING_FREE_PERCENT=15
UPLOAD_DISK_CRITICAL_FREE_PERCENT=8

# Erster Administrator. Das Passwort wird nur verwendet, wenn das Konto fehlt.
INITIAL_ADMIN_EMAIL=admin@example.com
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_DISPLAY_NAME=Administrator
SITE_NAME=AD-Wiki
ALLOW_REGISTRATION=false

# Anmeldung und Ratenbegrenzung
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
PASSWORD_RESET_TTL_MINUTES=30
THROTTLE_TTL=60000
THROTTLE_LIMIT=100
OIDC_ALLOWED_PRIVATE_HOSTS=
MCP_RATE_LIMIT_READ=120
MCP_RATE_LIMIT_WRITE=30
MCP_RATE_LIMIT_WINDOW_MS=60000

# Optionale Microsoft-Entra-Integration
MICROSOFT_TENANT_ID=
MICROSOFT_CLIENT_ID=
MICROSOFT_REDIRECT_URI=https://wiki.example.com/api/v1/integrations/microsoft/callback

# Einmalige OAuth- und MCP-Laufzeiten
MCP_OAUTH_ACCESS_TOKEN_TTL_SECONDS=900
MCP_OAUTH_REFRESH_TOKEN_TTL_SECONDS=2592000
MCP_OAUTH_REQUEST_TTL_SECONDS=600
MCP_OAUTH_CODE_TTL_SECONDS=300

# Fuer jeden Eintrag einen eigenen kryptografisch zufaelligen Wert verwenden.
# Allgemeines Secret: openssl rand -base64 48
# Exakt 32 Byte als Base64: openssl rand -base64 32
AD_WIKI_POSTGRES_PASSWORD=
AD_WIKI_JWT_SECRET=
AD_WIKI_MONITORING_TOKEN=
AD_WIKI_INTEGRATION_ENCRYPTION_KEY=
AD_WIKI_SSO_ENCRYPTION_KEY=
AD_WIKI_BACKUP_ENCRYPTION_KEY=
AD_WIKI_MICROSOFT_CLIENT_SECRET=
AD_WIKI_INITIAL_ADMIN_PASSWORD=
