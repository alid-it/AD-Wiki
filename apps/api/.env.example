# Database (matches the local docker-compose.yml setup)
NODE_ENV=development
DATABASE_URL="postgresql://adwiki:master@localhost:5432/adwiki_wiki"

# Authentication
# Generate a value, for example with: openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Optional API settings
THROTTLE_TTL=60000
THROTTLE_LIMIT=100
# UPLOAD_DIR=uploads

# URL of the AD-Wiki web application
WEB_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Generic OpenID Connect / SSO
# Public API origin used to build exact provider callback URLs.
OIDC_PUBLIC_API_URL=http://localhost:4000
# Development only: set true for a local HTTP Keycloak instance.
OIDC_ALLOW_INSECURE_HTTP=false
# Exakte interne DNS-Namen für kontrollierte Keycloak-/PKI-Ziele, kommasepariert.
OIDC_ALLOWED_PRIVATE_HOSTS=
# Separate 32-byte Base64 key for provider secrets, PKCE and nonce state.
# PowerShell: $b=[byte[]]::new(32); $r=[Security.Cryptography.RandomNumberGenerator]::Create(); $r.GetBytes($b); $r.Dispose(); [Convert]::ToBase64String($b)
SSO_ENCRYPTION_KEY=

# Reverse proxy and monitoring
TRUST_PROXY_HOPS=0
LOG_FORMAT=json
# Generate a separate random value for production monitoring access.
MONITORING_TOKEN=
BACKUP_STALE_AFTER_HOURS=26
BACKUP_WORKER_STALE_AFTER_SECONDS=60
BACKUP_SCHEDULE_GRACE_MINUTES=5
UPLOAD_DISK_WARNING_FREE_PERCENT=15
UPLOAD_DISK_CRITICAL_FREE_PERCENT=8
# In Produktion auf das schreibgeschützt eingebundene aktive Serverzertifikat setzen.
TLS_CERT_FILE=

# Shared production rate-limit store (required when NODE_ENV=production)
REDIS_URL=redis://localhost:6379

# Public MCP resource and DNS-rebinding protection
MCP_PUBLIC_URL=http://localhost:4000/mcp
MCP_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
MCP_ALLOWED_ORIGINS=http://localhost:3000
MCP_RATE_LIMIT_READ=120
MCP_RATE_LIMIT_WRITE=30
MCP_RATE_LIMIT_WINDOW_MS=60000

# OAuth 2.1 token lifetimes in seconds
MCP_OAUTH_ACCESS_TOKEN_TTL_SECONDS=900
MCP_OAUTH_REFRESH_TOKEN_TTL_SECONDS=2592000
MCP_OAUTH_REQUEST_TTL_SECONDS=600
MCP_OAUTH_CODE_TTL_SECONDS=300

# Production go-live:
# - set NODE_ENV=production
# - replace all localhost URLs with the final HTTPS domain
# - restrict host/origin allowlists to the deployed hostnames
# - generate a unique MONITORING_TOKEN and load all secrets from a secret store

# Microsoft Entra / Microsoft To Do integration
MICROSOFT_TENANT_ID=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_REDIRECT_URI=http://localhost:4000/api/v1/integrations/microsoft/callback

# Must be exactly 32 random bytes encoded as Base64.
# PowerShell: $b=[byte[]]::new(32); $r=[Security.Cryptography.RandomNumberGenerator]::Create(); $r.GetBytes($b); $r.Dispose(); [Convert]::ToBase64String($b)
# OpenSSL:    openssl rand -base64 32
INTEGRATION_ENCRYPTION_KEY=

# Separate 32-byte Base64 key for encrypted backup destination credentials.
# Never reuse JWT_SECRET or INTEGRATION_ENCRYPTION_KEY.
BACKUP_ENCRYPTION_KEY=
